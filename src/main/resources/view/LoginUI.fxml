<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="522.0" prefWidth="490.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.LoginUIController">
   <children>
      <Label layoutX="197.0" layoutY="42.0" prefHeight="48.0" prefWidth="95.0" text="LOGIN">
         <font>
            <Font name="Segoe UI Bold" size="24.0" />
         </font>
      </Label>
      <TextField fx:id="txtEmail" layoutX="106.0" layoutY="132.0" prefHeight="35.0" prefWidth="278.0" promptText="email address" />
      <TextField fx:id="txtPassword" layoutX="150.0" layoutY="219.0" prefHeight="35.0" prefWidth="190.0" promptText="password" />
      <Button layoutX="207.0" layoutY="306.0" mnemonicParsing="false" onAction="#btnLoginOnAction" prefHeight="35.0" prefWidth="66.0" style="-fx-background-color: #6289d1;" text="Login">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Label layoutX="168.0" layoutY="376.0" prefHeight="18.0" prefWidth="136.0" text="Don't have an account?" />
      <Button layoutX="188.0" layoutY="408.0" mnemonicParsing="false" onAction="#btnSignUpOnAction" prefHeight="35.0" prefWidth="95.0" style="-fx-background-color: #39b84e;" text="Sign-UP">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Label fx:id="txtInvalidEmail" layoutX="106.0" layoutY="178.0" prefHeight="18.0" prefWidth="136.0" />
      <Label fx:id="txtInvalidPassword" layoutX="156.0" layoutY="261.0" prefHeight="18.0" prefWidth="136.0" />
   </children>
</AnchorPane>
