<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="572.0" prefWidth="449.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.SignUpUIController">
   <children>
      <Label layoutX="149.0" layoutY="51.0" prefHeight="46.0" prefWidth="148.0" text="Registration">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <TextField fx:id="txtFirstName" layoutX="60.0" layoutY="128.0" prefHeight="35.0" prefWidth="284.0" promptText="First Name" />
      <TextField fx:id="txtLastName" layoutX="60.0" layoutY="199.0" prefHeight="35.0" prefWidth="284.0" promptText="Last Name" />
      <TextField fx:id="txtEmail" layoutX="60.0" layoutY="268.0" prefHeight="35.0" prefWidth="284.0" promptText="Email Address" />
      <TextField fx:id="txtReEnterEmail" layoutX="60.0" layoutY="336.0" prefHeight="35.0" prefWidth="284.0" promptText="Re-enter Email" />
      <Button layoutX="149.0" layoutY="403.0" mnemonicParsing="false" onAction="#btnSignUpOnAction" prefHeight="35.0" prefWidth="100.0" text="Sign-Up" />
      <Button layoutX="152.0" layoutY="477.0" mnemonicParsing="false" onAction="#loginOnAction" prefHeight="22.0" prefWidth="100.0" text="Back to Login" />
   </children>
</AnchorPane>
