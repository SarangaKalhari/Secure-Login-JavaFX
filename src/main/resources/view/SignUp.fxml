<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600" prefWidth="450"
            style="-fx-background-color: linear-gradient(to bottom right,#89a7d6,#586985);"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.icet.controller.SignUP.SignUpUIController">

    <!-- Registration Card -->
    <Pane layoutX="50" layoutY="40"
          prefHeight="520" prefWidth="350"
          style="-fx-background-color: rgba(255,255,255,0.95);
                 -fx-background-radius: 25;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20,0,0,5);
                 -fx-padding:30;">

        <!-- Title -->
        <Label layoutX="95" layoutY="20"
               text="Registration">
            <font>
                <Font name="System Bold" size="26"/>
            </font>
        </Label>

        <!-- First Name -->
        <TextField fx:id="txtFirstName"
                   layoutX="45" layoutY="80"
                   prefWidth="260"
                   promptText="First Name"
                   style="-fx-background-radius:15;
                          -fx-padding:10;
                          -fx-border-radius:15;
                          -fx-border-color:#e2e8f0;"/>

        <!-- Last Name -->
        <TextField fx:id="txtLastName"
                   layoutX="45" layoutY="130"
                   prefWidth="260"
                   promptText="Last Name"
                   style="-fx-background-radius:15;
                          -fx-padding:10;
                          -fx-border-radius:15;
                          -fx-border-color:#e2e8f0;"/>

        <!-- Email -->
        <TextField fx:id="txtEmail"
                   layoutX="45" layoutY="180"
                   prefWidth="260"
                   promptText="Email Address"
                   style="-fx-background-radius:15;
                          -fx-padding:10;
                          -fx-border-radius:15;
                          -fx-border-color:#e2e8f0;"/>

        <Label fx:id="lblEmail"
               layoutX="45" layoutY="215"
               style="-fx-text-fill:#ef4444; -fx-font-size:12px;"/>

        <!-- Password -->
        <PasswordField fx:id="txtPassword"
                       layoutX="45" layoutY="240"
                       prefWidth="260"
                       promptText="Password"
                       style="-fx-background-radius:15;
                              -fx-padding:10;
                              -fx-border-radius:15;
                              -fx-border-color:#e2e8f0;"/>

        <!-- Re-enter Password -->
        <PasswordField fx:id="txtReEnterPassword"
                       layoutX="45" layoutY="290"
                       prefWidth="260"
                       promptText="Re-enter Password"
                       style="-fx-background-radius:15;
                              -fx-padding:10;
                              -fx-border-radius:15;
                              -fx-border-color:#e2e8f0;"/>

        <Label fx:id="lblPassword"
               layoutX="45" layoutY="325"
               style="-fx-text-fill:#ef4444; -fx-font-size:12px;"/>

        <!-- Register Button -->
        <Button layoutX="45" layoutY="360"
                prefWidth="260"
                text="Register"
                onAction="#btnSignUpOnAction"
                style="-fx-background-color: linear-gradient(to right,#56dbc3,#1e40af);
                       -fx-text-fill:white;
                       -fx-font-weight:bold;
                       -fx-background-radius:15;
                       -fx-padding:12;
                       -fx-cursor:hand;"/>

        <!-- Login Link -->
        <Hyperlink layoutX="95" layoutY="430"
                   text="Already have an account?"
                   onAction="#loginOnAction"
                   style="-fx-text-fill:#2563eb;
                          -fx-font-weight:bold;"/>

    </Pane>

</AnchorPane>