<AnchorPane prefHeight="572.0" prefWidth="449.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.SignUP.SignUpUIController">
