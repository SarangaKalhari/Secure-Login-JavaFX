<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600" prefWidth="900" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.icet.controller.DashboardUI.DashBoardController">

    <!-- ===== Top Header ===== -->
    <Pane layoutX="0" layoutY="0" prefHeight="60" prefWidth="900" style="-fx-background-color: #1e293b;">

        <Label layoutX="20" layoutY="18" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="My Application Dashboard" />

        <Button layoutX="820" layoutY="15" onAction="#handleLogout" prefWidth="60" style="-fx-background-color: #ef4444; -fx-text-fill: white;" text="Logout" />
    </Pane>

    <!-- ===== Sidebar ===== -->
    <Pane layoutX="0" layoutY="60" prefHeight="540" prefWidth="200" style="-fx-background-color: #0f172a;">

        <Label layoutX="75" layoutY="20" style="-fx-text-fill: #94a3b8; -fx-font-size: 14px;" text="MENU" />

        <Button layoutX="20" layoutY="60" prefWidth="160" style="-fx-background-color: #1e293b; -fx-text-fill: white;" text="Home" />

        <Button layoutX="20" layoutY="110" prefWidth="160" style="-fx-background-color: #1e293b; -fx-text-fill: white;" text="Profile" />

        <Button layoutX="20" layoutY="160" prefWidth="160" style="-fx-background-color: #1e293b; -fx-text-fill: white;" text="Settings" />
    </Pane>

    <!-- ===== Main Content Area ===== -->
    <Pane layoutX="200" layoutY="60" prefHeight="540" prefWidth="700" style="-fx-background-color: white;">

        <Label layoutX="200" layoutY="80" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Welcome to Your Dashboard 🎉" />

        <Label layoutX="200" layoutY="130" style="-fx-font-size: 14px; -fx-text-fill: #475569;" text="Login successful. You can add your content here." />
      <Label fx:id="lblEmail" layoutX="226.0" layoutY="186.0" prefHeight="60.0" prefWidth="244.0" textFill="#1bcf26">
         <font>
            <Font name="System Bold Italic" size="24.0" />
         </font></Label>

    </Pane>

</AnchorPane>
